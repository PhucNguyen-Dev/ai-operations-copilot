# ---- Supabase (fill these in — see docs/DATABASE.md step 3) ----
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used ONLY by scripts/seed-users.mjs.
# NEVER expose this to the browser or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Phase 3: n8n + OpenAI ----
# Local pipeline webhook (started with: npm run n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/admissions-lead
# Shared secret between the Next.js API and the n8n webhook (any long random string)
N8N_WEBHOOK_SECRET=
# OpenAI — get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
