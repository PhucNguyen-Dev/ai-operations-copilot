# ---- Supabase (fill these in — Supabase dashboard → Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by scripts/seed-users.mjs and the n8n pipeline.
# NEVER expose this to the browser or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. JWT secret (Supabase Dashboard -> Settings -> API -> JWT Secret).
# Used by scripts/start-n8n.mjs to mint the least-privilege n8n_pipeline JWT
# (migration 008, R-08). Without it n8n falls back to service-role writes.
SUPABASE_JWT_SECRET=

# ---- n8n + Gemini (Phase 3) ----
# Local pipeline webhook (started with: npm run n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/admissions-lead
# Shared secret between the Next.js API and the n8n webhook (any long random string)
N8N_WEBHOOK_SECRET=
# Google Gemini — free key at https://aistudio.google.com (no card needed)
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# ---- Gmail (Phase 4, F-009) ----
# true (default) = never send; the pipeline records the email in sent_emails with status 'dry_run'.
# Set to false ONLY after wiring real Gmail credentials below.
GMAIL_DRY_RUN=true
# Google Cloud OAuth app + refresh token with gmail.send scope (only needed when GMAIL_DRY_RUN=false)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Sender address shown on outgoing email (defaults to the assigned counselor's email)
GMAIL_FROM=

# ---- Telegram parent chatbot ----
# Token from @BotFather (Telegram > /newbot)
TELEGRAM_BOT_TOKEN=
# Webhook secret shared by the Telegram trigger node and the launcher's
# setWebhook/heal calls (R-11). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Preferred localtunnel subdomain for the bot's public webhook (npm run bot).
# Optional — if it's taken/zombie, start-bot.mjs verifies and falls back to a random one.
TUNNEL_SUBDOMAIN=aileads-dev
